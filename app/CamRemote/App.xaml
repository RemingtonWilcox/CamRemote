<Application x:Class="CamRemote.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Dim" Color="#9A9A9A" />
        <SolidColorBrush x:Key="Rec" Color="#E5322D" />
        <SolidColorBrush x:Key="Ok" Color="#4CC26A" />
        <SolidColorBrush x:Key="Warn" Color="#E8B339" />

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <!-- The Video and Photo pages, underlined like tabs because they change everything below them. -->
        <Style x:Key="PageTab" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Line" Background="Transparent" BorderBrush="#3A3A3A" BorderThickness="0,0,0,2" Padding="0,8">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Line" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The side panel's buttons, drawn like the iPhone app's: dark rounded tiles, the chosen one lighter. -->
        <SolidColorBrush x:Key="Panel" Color="#1B1E22" />
        <SolidColorBrush x:Key="Chosen" Color="#3A4048" />
        <SolidColorBrush x:Key="Line" Color="#30353B" />
        <ControlTemplate x:Key="TileFace" TargetType="ButtonBase">
            <Grid>
                <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                <!-- Lightens whatever colour the button is, so a red Stop button stays red under the mouse -->
                <Border x:Name="Glow" Background="White" CornerRadius="8" Opacity="0" />
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Glow" Property="Opacity" Value="0.06" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Glow" Property="Opacity" Value="0.12" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="PanelButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource TileFace}" />
        </Style>
        <Style x:Key="PanelToggle" TargetType="ToggleButton" BasedOn="{StaticResource PanelButton}">
            <Setter Property="Foreground" Value="#B8B8B8" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource Chosen}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A setting as a tile, like the iPhone app: its name small and grey, its value below. -->
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource PanelButton}">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Application.Resources>
</Application>
