<Window x:Class="CamRemote.JoinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="CamRemote.ico"
        Title="Egret" Width="1400" Height="860" MinWidth="900" MinHeight="560" Background="#16181B"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" KeyDown="OnKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status strip over the picture -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="14,10" LastChildFill="False">
            <Border x:Name="RecBadge" DockPanel.Dock="Left" Background="{StaticResource Rec}" CornerRadius="4"
                    Padding="8,2" Margin="0,0,12,0" Visibility="Collapsed">
                <TextBlock Text="● REC" FontSize="15" FontWeight="Bold" Foreground="White" />
            </Border>
            <TextBlock x:Name="CamSummary" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="CardText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="15" />
            <TextBlock x:Name="BatteryText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="15" />
        </DockPanel>

        <!-- The host's live picture. Click to focus. -->
        <Border Grid.Row="1" Grid.Column="0" Background="Black">
            <Grid>
                <TextBlock x:Name="NoSignal" Text="Waiting for the picture…" Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Grid x:Name="PictureBox" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.LayoutTransform>
                        <RotateTransform x:Name="PictureRotation" Angle="0" />
                    </Grid.LayoutTransform>
                    <Image x:Name="Picture" Stretch="Uniform" Cursor="Cross" MouseLeftButtonDown="OnPictureClick" />
                    <Image x:Name="AssistLayer" Stretch="Uniform" IsHitTestVisible="False" />
                    <Canvas IsHitTestVisible="False">
                        <Ellipse x:Name="FocusMark" Width="20" Height="20" Stroke="#C0FFFFFF" StrokeThickness="1.5" Visibility="Collapsed" />
                    </Canvas>
                </Grid>
                <Border x:Name="AlertBox" Background="#CC1B1E22" CornerRadius="6" Padding="12,6" Margin="0,14,0,0"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock x:Name="AlertText" Foreground="{StaticResource Warn}" FontSize="14" TextWrapping="Wrap" />
                </Border>
                <Border x:Name="Hud" Background="#B0101214" CornerRadius="6" Padding="8" Margin="14"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="280" IsHitTestVisible="False">
                    <StackPanel>
                        <Image x:Name="Histogram" Height="40" Stretch="Fill" />
                        <TextBlock x:Name="OverText" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,4,0,0" />
                        <TextBlock x:Name="MeterText" FontSize="11" Foreground="{StaticResource Dim}" />
                    </StackPanel>
                </Border>
                <Border x:Name="Toast" Background="#E61B1E22" CornerRadius="6" Padding="14,8" Margin="0,0,0,24"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed">
                    <TextBlock x:Name="ToastText" Foreground="White" FontSize="14" TextWrapping="Wrap" MaxWidth="560" />
                </Border>
            </Grid>
        </Border>

        <!-- Controls -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="#101214" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,14,16,0">
                    <DockPanel>
                        <Button Content="Leave" Click="OnLeaveClick" Padding="10,3" DockPanel.Dock="Right"
                                ToolTip="Stop using the camera through the other CamRemote" />
                        <Ellipse x:Name="LinkDot" Width="10" Height="10" Fill="#666" Margin="0,0,8,0" DockPanel.Dock="Left" />
                        <TextBlock x:Name="LinkText" Text="Joining…" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock x:Name="HostText" Foreground="{StaticResource Dim}" FontSize="12" Margin="18,2,0,0" TextTrimming="CharacterEllipsis" />
                    <UniformGrid Rows="1" Margin="0,12,0,0">
                        <ToggleButton x:Name="VideoTab" Content="Video" Style="{StaticResource PageTab}" Click="OnModeClick" IsChecked="True"
                                      ToolTip="Switches the camera to movie mode." />
                        <ToggleButton x:Name="PhotoTab" Content="Photo" Style="{StaticResource PageTab}" Click="OnModeClick"
                                      ToolTip="Switches the camera to photo mode." />
                    </UniformGrid>
                    <Button x:Name="RecButton" Click="OnRecClick" Height="56" Margin="0,14,0,0" IsEnabled="False"
                            HorizontalAlignment="Stretch" ToolTip="Start / stop recording (F9)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecDot" Width="18" Height="18" Fill="{StaticResource Rec}" Margin="0,0,10,0" />
                            <TextBlock x:Name="RecLabel" Text="Record" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShutterButton" Height="56" Margin="0,14,0,0" IsEnabled="False" HorizontalAlignment="Stretch" Visibility="Collapsed"
                            PreviewMouseLeftButtonDown="OnShutterDown" PreviewMouseLeftButtonUp="OnShutterUp" LostMouseCapture="OnShutterUp"
                            ToolTip="Take a photo (F9). Hold it down for a burst when Drive is set to continuous.">
                        <TextBlock Text="Take photo" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel Margin="16,0,16,16">
                        <!-- C1 to C4: the other CamRemote's own presets, for the side its camera is on. One per row. -->
                        <StackPanel x:Name="PresetButtons" Margin="0,8,0,0" />
                        <UniformGrid x:Name="SlowQuickSwitch" Rows="1" Margin="0,6,0,0" Visibility="Collapsed">
                            <ToggleButton x:Name="NormalSpeed" Content="Normal" Style="{StaticResource PanelToggle}" Margin="0,0,4,0" Click="OnSlowQuickClick"
                                          ToolTip="Records at normal speed." />
                            <ToggleButton x:Name="SlowQuick" Content="S&amp;Q" Style="{StaticResource PanelToggle}" Margin="0,0,4,0" Click="OnSlowQuickClick"
                                          ToolTip="Slow and quick motion: shoots at one frame rate and plays back at another, such as 240fps played at 24p." />
                        </UniformGrid>
                        <UniformGrid x:Name="BaseIsoPanel" Rows="1" Margin="0,10,0,0" Visibility="Collapsed" />
                        <TextBlock Text="EXPOSURE" Style="{StaticResource Section}" />
                        <StackPanel x:Name="ExposureRows" />
                        <TextBlock Text="FOCUS" Style="{StaticResource Section}" />
                        <StackPanel x:Name="FocusRows" />
                        <StackPanel x:Name="FocusRing" Visibility="Collapsed" Margin="0,6,0,0">
                            <TextBlock Text="Focus ring (manual focus)" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <UniformGrid x:Name="RingButtons" Rows="1" />
                        </StackPanel>
                        <Button x:Name="StopTracking" Content="Stop tracking" Click="OnStopTrackingClick" Margin="0,8,0,0"
                                Style="{StaticResource PanelButton}" Visibility="Collapsed" />
                        <StackPanel x:Name="MagnifyBox" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock Text="Magnify" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <UniformGrid x:Name="MagnifyButtons" Rows="1" />
                        </StackPanel>
                        <TextBlock Text="GUIDES" Style="{StaticResource Section}" />
                        <UniformGrid Rows="1">
                            <ToggleButton x:Name="HistToggle" Content="Histogram" Style="{StaticResource PanelToggle}" Margin="0,0,4,0" Click="OnGuideClick" />
                            <ToggleButton x:Name="ZebraToggle" Content="Zebras" Style="{StaticResource PanelToggle}" Margin="0,0,4,0" Click="OnGuideClick" />
                            <ToggleButton x:Name="PeakToggle" Content="Peaking" Style="{StaticResource PanelToggle}" Margin="0,0,4,0" Click="OnGuideClick" />
                        </UniformGrid>
                        <Button Content="Turn the picture 90°" Style="{StaticResource PanelButton}" Click="OnRotateClick" Margin="0,4,4,0"
                                ToolTip="For a camera on its side. Only on this computer." />
                        <TextBlock x:Name="AudioHead" Text="AUDIO" Style="{StaticResource Section}" />
                        <StackPanel x:Name="AudioRows" />
                        <TextBlock x:Name="MoreHead" Text="MORE" Style="{StaticResource Section}" />
                        <StackPanel x:Name="MoreRows" />
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,18,0,0"
                                   Text="The camera is held by the other Egret, which passes the picture and your changes on. Automatic recording, and where photos are saved, are set there." />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
