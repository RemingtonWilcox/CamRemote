<Window x:Class="CamRemote.JoinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="CamRemote.ico"
        Title="Egret" Width="1500" Height="900" MinWidth="980" MinHeight="600" Background="#16181B"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" KeyDown="OnKeyDown">
    <!-- Laid out like MainWindow, so the camera looks the same whether this computer holds it or another Egret does. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Status strip over the picture -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="14,10" LastChildFill="False">
            <Border x:Name="RecBadge" DockPanel.Dock="Left" Background="{StaticResource Rec}" CornerRadius="4"
                    Padding="8,2" Margin="0,0,12,0" Visibility="Collapsed">
                <TextBlock x:Name="RecTime" Text="● REC 00:00:00" FontSize="15" FontWeight="Bold" Foreground="White" />
            </Border>
            <TextBlock x:Name="CamSummary" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="CardText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="15" />
            <TextBlock x:Name="BatteryText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="15" />
        </DockPanel>

        <!-- The host's live picture. Click to focus. -->
        <Border Grid.Row="1" Grid.Column="0" Background="Black">
            <Grid>
                <TextBlock x:Name="NoSignal" Text="Waiting for the picture…" Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border x:Name="RecFrame" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="3" BorderBrush="Transparent">
                    <Grid x:Name="PictureBox" ClipToBounds="True">
                        <Grid.LayoutTransform>
                            <RotateTransform x:Name="PictureRotation" Angle="0" />
                        </Grid.LayoutTransform>
                        <Image x:Name="Picture" Stretch="Uniform" Cursor="Cross" MouseLeftButtonDown="OnPictureClick" />
                        <Image x:Name="AssistLayer" Stretch="Uniform" IsHitTestVisible="False" />
                        <Grid x:Name="GuideGrid" IsHitTestVisible="False" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#80FFFFFF" BorderThickness="1,0" />
                            <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#80FFFFFF" BorderThickness="0,1" />
                            <Rectangle Grid.Row="1" Grid.Column="1" Width="24" Height="1" Fill="#B0FFFFFF" />
                            <Rectangle Grid.Row="1" Grid.Column="1" Width="1" Height="24" Fill="#B0FFFFFF" />
                        </Grid>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="FocusMark" Width="20" Height="20" Stroke="#C0FFFFFF" StrokeThickness="1.5" Visibility="Collapsed" />
                        </Canvas>
                    </Grid>
                </Border>
                <!-- The histogram and the camera's meter, as in MainWindow -->
                <Border x:Name="Hud" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" Width="280"
                        Background="#D0121417" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,8" IsHitTestVisible="False">
                    <StackPanel>
                        <StackPanel x:Name="HistogramPart">
                            <Border Height="64" Background="#1E1E1E" CornerRadius="3">
                                <Image x:Name="Histogram" Stretch="Fill" />
                            </Border>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock x:Name="UnderText" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource Dim}" />
                                <TextBlock x:Name="OverText" FontSize="11" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel x:Name="MeterBox" Margin="0,6,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ExposureText" FontSize="13" FontWeight="SemiBold" />
                            <Canvas x:Name="ExposureScale" Height="32" Margin="0,2,0,0" SizeChanged="OnExposureScaleSized">
                                <Rectangle x:Name="ExposureNeedle" Width="3" Height="18" Fill="White" />
                            </Canvas>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="AlertBox" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                        CornerRadius="6" Padding="16,8" Background="{StaticResource Rec}" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="AlertText" Foreground="White" FontSize="16" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                </Border>
                <Border x:Name="Toast" Background="#E61B1E22" CornerRadius="6" Padding="14,8" Margin="0,0,0,24"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed">
                    <TextBlock x:Name="ToastText" Foreground="White" FontSize="14" TextWrapping="Wrap" MaxWidth="560" />
                </Border>
            </Grid>
        </Border>

        <!-- Under the picture's corner: what's drawn over it and which way up it is -->
        <DockPanel Grid.Row="2" Grid.Column="0" Margin="12,6" Background="Transparent">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <ToggleButton x:Name="GridChip" Content="Grid" Style="{StaticResource Chip}" Click="OnGuideClick" ToolTip="Rule of thirds and centre mark (G)" />
                <ToggleButton x:Name="ZebraChip" Content="Zebras" Style="{StaticResource Chip}" Click="OnGuideClick" ToolTip="Stripe the brightest parts of the picture (Z)" />
                <ToggleButton x:Name="PeakingChip" Content="Peaking" Style="{StaticResource Chip}" Click="OnGuideClick" ToolTip="Colour the parts in focus (P)" />
                <ToggleButton x:Name="HistogramChip" Content="Histogram" Style="{StaticResource Chip}" Click="OnGuideClick" ToolTip="Show the histogram (H)" />
                <Border Width="1" Background="#3A3F45" Margin="10,4" />
                <Button Content="⟲" Padding="9,1" MinHeight="26" FontSize="15" Focusable="False" Click="OnRotateClick" Tag="-90"
                        ToolTip="Turn the picture a quarter turn left, for a camera on its side (Shift+R)" />
                <TextBlock x:Name="RotationText" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Dim}" />
                <Button Content="⟳" Padding="9,1" MinHeight="26" FontSize="15" Focusable="False" Click="OnRotateClick" Tag="90"
                        ToolTip="Turn the picture a quarter turn right, for a camera on its side (R)" />
            </StackPanel>
            <TextBlock x:Name="HostText" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Controls -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" BorderBrush="#333" BorderThickness="1,0,0,0">
            <Border.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource PanelButton}" />
                <Style TargetType="RepeatButton" BasedOn="{StaticResource PanelButton}" />
                <Style TargetType="ToggleButton" BasedOn="{StaticResource PanelToggle}" />
            </Border.Resources>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,10,16,0">
                    <DockPanel>
                        <Button Content="Leave" Click="OnLeaveClick" Padding="10,3" DockPanel.Dock="Right"
                                ToolTip="Stop using the camera through the other Egret" />
                        <Ellipse x:Name="LinkDot" Width="10" Height="10" Fill="#666" Margin="0,0,8,0" DockPanel.Dock="Left" />
                        <TextBlock x:Name="LinkText" Text="Joining…" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <UniformGrid Rows="1" Margin="0,12,0,0">
                        <ToggleButton x:Name="VideoTab" Content="Video" Style="{StaticResource PageTab}" Click="OnModeClick" IsChecked="True"
                                      ToolTip="Switches the camera to movie mode." />
                        <ToggleButton x:Name="PhotoTab" Content="Photo" Style="{StaticResource PageTab}" Click="OnModeClick"
                                      ToolTip="Switches the camera to photo mode." />
                        <ToggleButton x:Name="SetupTab" Content="Setup" Style="{StaticResource PageTab}" Click="OnSetupClick"
                                      ToolTip="Settings you set once or now and then." />
                    </UniformGrid>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,0,16,16">
                        <!-- What changes while shooting -->
                        <StackPanel x:Name="ShootPage">
                            <Button x:Name="RecButton" Click="OnRecClick" Height="56" Margin="0,10,0,0" IsEnabled="False"
                                    HorizontalAlignment="Stretch" ToolTip="Start / stop recording (F9)">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="RecDot" Width="18" Height="18" Fill="{StaticResource Rec}" Margin="0,0,10,0" />
                                    <TextBlock x:Name="RecLabel" Text="Record" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ShutterButton" Height="56" Margin="0,10,0,0" IsEnabled="False" HorizontalAlignment="Stretch" Visibility="Collapsed"
                                    PreviewMouseLeftButtonDown="OnShutterDown" PreviewMouseLeftButtonUp="OnShutterUp" LostMouseCapture="OnShutterUp"
                                    ToolTip="Take a photo (F9). Hold it down for a burst when Drive is set to continuous.">
                                <TextBlock x:Name="ShutterLabel" Text="Take photo" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Button>
                            <TextBlock x:Name="TimeLapseNote" TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
                            <StackPanel x:Name="DriveRows" Margin="0,4,0,0" />
                            <!-- C1 to C4: the other Egret's own presets, for the side its camera is on. One per row. -->
                            <StackPanel x:Name="PresetButtons" Margin="0,8,0,0" />

                            <TextBlock Text="EXPOSURE" Style="{StaticResource Section}" />
                            <StackPanel x:Name="ExposureRows" />
                            <UniformGrid x:Name="BaseIsoPanel" Rows="1" Margin="0,0,0,4" Visibility="Collapsed" />

                            <TextBlock Text="FOCUS" Style="{StaticResource Section}" />
                            <StackPanel x:Name="FocusRows" />
                            <StackPanel x:Name="FocusRing" Visibility="Collapsed" Margin="0,2,0,0">
                                <TextBlock Text="Focus ring: drag or scroll" FontSize="12" Foreground="Gray" Margin="0,0,0,3" />
                                <Border x:Name="FocusWheel" Height="44" Margin="0,0,0,6" Background="#1B1E22" BorderBrush="#30353B" BorderThickness="1"
                                        CornerRadius="8" ClipToBounds="True" Cursor="SizeWE" MouseLeftButtonDown="OnWheelDown" MouseMove="OnWheelMove"
                                        MouseLeftButtonUp="OnWheelUp" MouseWheel="OnWheelScroll" ToolTip="Drag slowly for fine focus, faster for bigger moves.">
                                    <Canvas x:Name="WheelTicks" />
                                </Border>
                                <DockPanel>
                                    <RepeatButton DockPanel.Dock="Left" Tag="-7" Click="OnFocusStep" Delay="300" Interval="120" Width="36" ToolTip="Hold to focus nearer">
                                        <TextBlock Text="✿" FontSize="15" />
                                    </RepeatButton>
                                    <RepeatButton DockPanel.Dock="Right" Tag="7" Click="OnFocusStep" Delay="300" Interval="120" Width="46" ToolTip="Hold to focus farther">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M0,12 L5,3 L8,7 L10,5 L15,12 Z" Fill="#DDD" VerticalAlignment="Center" Margin="0,0,3,0" />
                                            <TextBlock Text="∞" FontSize="15" />
                                        </StackPanel>
                                    </RepeatButton>
                                    <UniformGrid Rows="1" Margin="4,0">
                                        <RepeatButton Tag="-1" Click="OnFocusStep" Delay="300" Interval="120" Margin="0,0,2,0" ToolTip="A little nearer">◀</RepeatButton>
                                        <RepeatButton Tag="1" Click="OnFocusStep" Delay="300" Interval="120" Margin="2,0,0,0" ToolTip="A little farther">▶</RepeatButton>
                                    </UniformGrid>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel x:Name="MagnifyBox" Visibility="Collapsed">
                                <TextBlock Text="Focus magnifier" FontSize="12" Foreground="Gray" Margin="0,8,0,3" />
                                <StackPanel x:Name="MagnifyButtons" Orientation="Horizontal" />
                            </StackPanel>
                            <Button x:Name="StopTracking" Content="Stop tracking" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnStopTrackingClick" Visibility="Collapsed" />

                            <StackPanel x:Name="VideoShoot">
                                <TextBlock Text="RECORDING" Style="{StaticResource Section}" />
                                <UniformGrid x:Name="SlowQuickSwitch" Rows="1" Margin="-2,0,-2,4" Visibility="Collapsed">
                                    <ToggleButton x:Name="NormalSpeed" Content="Normal" Margin="2" Click="OnSlowQuickClick" ToolTip="Records at normal speed." />
                                    <ToggleButton x:Name="SlowQuick" Content="S&amp;Q" Margin="2" Click="OnSlowQuickClick"
                                                  ToolTip="Slow and quick motion: shoots at one frame rate and plays back at another, such as 240fps played at 24p." />
                                </UniformGrid>
                                <StackPanel x:Name="RecordingRows" />
                            </StackPanel>
                        </StackPanel>

                        <!-- What gets set once or now and then -->
                        <StackPanel x:Name="SetupPage" Visibility="Collapsed">
                            <TextBlock x:Name="PhotoHead" Text="PHOTO" Style="{StaticResource Section}" />
                            <StackPanel x:Name="PhotoRows" />
                            <TextBlock x:Name="AudioHead" Text="AUDIO" Style="{StaticResource Section}" />
                            <StackPanel x:Name="AudioRows" />
                            <TextBlock x:Name="MoreHead" Text="CAMERA" Style="{StaticResource Section}" />
                            <StackPanel x:Name="MoreRows" />

                            <TextBlock Text="CONNECTION" Style="{StaticResource Section}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="12"
                                       Text="The camera is held by the other Egret, which passes the picture and your changes on. Automatic recording, time-lapse and where photos are saved are set there." />

                            <TextBlock Text="SOMETHING NOT WORKING?" Style="{StaticResource Section}" />
                            <TextBlock Text="What happened? (optional)" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="LogNote" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" MaxLength="2000" />
                            <Button x:Name="SendLogButton" Content="Send log to the developer" Margin="0,6,0,0" Click="OnSendLogClick" />
                            <TextBlock x:Name="SendLogResult" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                       Text="It sends what the app did, with your camera's model and its address on your network. No passwords, photos or video." />
                            <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0" FontSize="11">
                                <Hyperlink Click="OnHelpClick" Foreground="{StaticResource Dim}"
                                           ToolTip="Opens the help on GitHub: what to try when something isn't working.">Help</Hyperlink>
                                <Run Text="  ·  " Foreground="{StaticResource Dim}" />
                                <Hyperlink Click="OnInstagramClick" Foreground="{StaticResource Dim}"
                                           ToolTip="Opens @remingtonwilcox on Instagram.">Instagram</Hyperlink>
                            </TextBlock>
                            <TextBlock x:Name="AboutText" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource Dim}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
