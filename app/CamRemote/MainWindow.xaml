<Window x:Class="CamRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="CamRemote.ico"
        Title="CamRemote" Width="1500" Height="900" MinWidth="980" MinHeight="600"
        Loaded="OnLoaded" Closing="OnClosing" KeyDown="OnKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="310" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Status strip over the picture -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="12,8" LastChildFill="False">
            <Border x:Name="RecBadge" DockPanel.Dock="Left" Background="{StaticResource Rec}" CornerRadius="4"
                    Padding="8,2" Margin="0,0,12,0" Visibility="Collapsed">
                <TextBlock x:Name="RecTime" Text="● REC 00:00:00" FontWeight="Bold" Foreground="White" />
            </Border>
            <TextBlock x:Name="CamSummary" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="14" />
            <TextBlock x:Name="CardText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
            <TextBlock x:Name="BatteryText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
        </DockPanel>

        <!-- Shooting guides: quick toggles, then the meter and histogram. Click the histogram for detail. -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="12,0,12,8" Height="38" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="HistogramChip" Content="Histogram" Style="{StaticResource Chip}" Click="OnAssistToggle" ToolTip="Show the histogram (H)" />
                <ToggleButton x:Name="ZebraChip" Content="Zebras" Style="{StaticResource Chip}" Click="OnAssistToggle" ToolTip="Stripe the brightest parts of the picture (Z)" />
                <ToggleButton x:Name="PeakingChip" Content="Peaking" Style="{StaticResource Chip}" Click="OnAssistToggle" ToolTip="Colour the parts in focus (P)" />
                <ToggleButton x:Name="GridChip" Content="Grid" Style="{StaticResource Chip}" Click="OnAssistToggle" ToolTip="Rule of thirds and centre mark (G)" />
                <Button Content="⋯" Padding="9,3" MinHeight="26" Focusable="False" Click="OnAssistDetailClick" ToolTip="Levels, colours and the full histogram" />
            </StackPanel>
            <Grid x:Name="HistogramBox" DockPanel.Dock="Right" Width="128" Background="#1E1E1E" Cursor="Hand"
                  MouseLeftButtonDown="OnAssistDetailClick" ToolTip="Brightness of the picture. Amber is past the zebra level. Click for detail.">
                <Image x:Name="HistogramSmall" Stretch="Fill" />
            </Grid>
            <StackPanel x:Name="ClipBox" DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="OverText" FontSize="11" TextAlignment="Right" />
                <TextBlock x:Name="UnderText" FontSize="11" TextAlignment="Right" Foreground="{StaticResource Dim}" />
            </StackPanel>
            <StackPanel x:Name="MeterBox" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center"
                        ToolTip="The camera's exposure meter, in stops.">
                <TextBlock x:Name="ExposureText" Width="34" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Canvas x:Name="ExposureScale" Width="150" Height="24">
                    <Rectangle x:Name="ExposureNeedle" Width="3" Height="24" Fill="White" />
                </Canvas>
            </StackPanel>
        </DockPanel>

        <!-- Live picture from the capture card. Click to focus, right-click to cancel. -->
        <Border Grid.Row="2" Grid.Column="0" Background="Black">
            <Grid>
                <TextBlock x:Name="NoSignal" Text="No video — pick a picture source on the right"
                           Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Turns red while recording -->
                <Border x:Name="RecFrame" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderThickness="3" BorderBrush="Transparent">
                <Grid x:Name="PictureHost" ClipToBounds="True">
                    <Grid.LayoutTransform>
                        <RotateTransform x:Name="PictureRotation" Angle="0" />
                    </Grid.LayoutTransform>
                    <Image x:Name="Picture" Stretch="Uniform" Cursor="Cross"
                           MouseLeftButtonDown="OnPictureClick" MouseRightButtonDown="OnPictureRightClick" />
                    <Image x:Name="AssistLayer" Stretch="Uniform" IsHitTestVisible="False" Visibility="Collapsed" />
                    <Grid x:Name="GuideGrid" IsHitTestVisible="False" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#80FFFFFF" BorderThickness="1,0" />
                        <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#80FFFFFF" BorderThickness="0,1" />
                        <Rectangle Grid.Row="1" Grid.Column="1" Width="24" Height="1" Fill="#B0FFFFFF" />
                        <Rectangle Grid.Row="1" Grid.Column="1" Width="1" Height="24" Fill="#B0FFFFFF" />
                    </Grid>
                    <!-- The boxes the camera reports -->
                    <Canvas x:Name="FrameLayer" IsHitTestVisible="False" />
                    <Canvas x:Name="Overlay" IsHitTestVisible="False">
                        <!-- Where the click landed, not a focus box -->
                        <Ellipse x:Name="FocusMark" Width="20" Height="20" Stroke="#C0FFFFFF" StrokeThickness="1.5"
                                 Visibility="Collapsed" />
                        <!-- What the animal trigger sees -->
                        <Rectangle x:Name="AnimalBox" Stroke="#4CD964" StrokeThickness="2" Visibility="Collapsed" />
                        <TextBlock x:Name="AnimalLabel" Text="animal" FontSize="12" Foreground="White" Background="#B0000000"
                                   Padding="4,1" Visibility="Collapsed">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="AnimalLabelTurn" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                </Grid>
                </Border>
                <Button x:Name="ZoomBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,2" Background="#F2C94C"
                        Foreground="Black" FontWeight="Bold" FontSize="12" Visibility="Collapsed" Click="OnZoomBadgeClick"
                        ToolTip="The picture is enlarged. Click here to go back to the whole picture." />
                <Border x:Name="AlertBanner" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                        CornerRadius="6" Padding="16,8" Background="{StaticResource Rec}" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="AlertText" Foreground="White" FontSize="16" FontWeight="Bold" TextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Messages -->
        <DockPanel Grid.Row="3" Grid.Column="0" Margin="12,6">
            <Button x:Name="UpdateButton" DockPanel.Dock="Left" Margin="0,0,10,0" Padding="10,3" Background="#2E7D32" Foreground="White"
                    Visibility="Collapsed" Click="OnUpdateClick" ToolTip="Opens the download page in your browser." />
            <TextBlock x:Name="VideoInfo" DockPanel.Dock="Right" Foreground="{StaticResource Dim}" />
            <TextBlock x:Name="MessageText" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Controls -->
        <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" BorderBrush="#333" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,10,16,16">
                    <DockPanel>
                        <Ellipse x:Name="LinkDot" Width="10" Height="10" Fill="#666" Margin="0,0,8,0" DockPanel.Dock="Left" />
                        <TextBlock x:Name="LinkText" Text="Camera not connected" VerticalAlignment="Center" />
                    </DockPanel>
                    <Button x:Name="ConnectButton" Content="Connect camera…" Click="OnConnectClick" Margin="0,8,0,0"
                            HorizontalAlignment="Stretch" />

                    <Button x:Name="RecButton" Click="OnRecClick" Height="56" Margin="0,14,0,0" IsEnabled="False"
                            HorizontalAlignment="Stretch" ToolTip="Start / stop recording (F9)">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecDot" Width="18" Height="18" Fill="{StaticResource Rec}" Margin="0,0,10,0" />
                            <TextBlock x:Name="RecLabel" Text="Record" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="BirdWatch" Margin="0,10,0,0" Content="Record when an animal shows up" Checked="OnBirdWatchClick" Unchecked="OnBirdWatchClick"
                              ToolTip="Checks the picture once a second, on this computer only." />
                    <TextBlock x:Name="BirdStatus" FontSize="12" Foreground="Gray" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                    <TextBlock Text="EXPOSURE" Style="{StaticResource Section}" />
                    <StackPanel x:Name="ExposurePanel" />
                    <UniformGrid x:Name="BaseIsoButtons" Visibility="Collapsed" Rows="1" Margin="0,0,0,4">
                        <Button x:Name="IsoLowButton" Margin="0,0,3,0" Padding="4,6" Click="OnBaseIsoClick"
                                ToolTip="Lower native ISO of this camera" />
                        <Button x:Name="IsoHighButton" Margin="3,0,0,0" Padding="4,6" Click="OnBaseIsoClick"
                                ToolTip="Upper native ISO of this camera, cleanest in low light" />
                    </UniformGrid>

                    <TextBlock Text="FOCUS" Style="{StaticResource Section}" />
                    <StackPanel x:Name="FocusPanel" />
                    <StackPanel x:Name="ManualFocus" Margin="0,2,0,0">
                        <TextBlock Text="Focus ring: drag or scroll" FontSize="12" Foreground="Gray" Margin="0,0,0,3" />
                        <Border x:Name="FocusWheel" Height="44" Margin="0,0,0,6" Background="#191919" BorderBrush="#444" BorderThickness="1"
                                CornerRadius="4" ClipToBounds="True" Cursor="SizeWE" MouseLeftButtonDown="OnWheelDown" MouseMove="OnWheelMove"
                                MouseLeftButtonUp="OnWheelUp" MouseWheel="OnWheelScroll" ToolTip="Drag slowly for fine focus, faster for bigger moves.">
                            <Canvas x:Name="WheelTicks" />
                        </Border>
                        <DockPanel>
                            <RepeatButton DockPanel.Dock="Left" Tag="-7" Click="OnFocusStep" Delay="300" Interval="120" Width="36" ToolTip="Hold to focus nearer">
                                <TextBlock Text="✿" FontSize="15" />
                            </RepeatButton>
                            <RepeatButton DockPanel.Dock="Right" Tag="7" Click="OnFocusStep" Delay="300" Interval="120" Width="46" ToolTip="Hold to focus farther">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M0,12 L5,3 L8,7 L10,5 L15,12 Z" Fill="#DDD" VerticalAlignment="Center" Margin="0,0,3,0" />
                                    <TextBlock Text="∞" FontSize="15" />
                                </StackPanel>
                            </RepeatButton>
                            <Border x:Name="FocusBar" Height="32" Margin="4,0" Background="#191919" BorderBrush="#444" BorderThickness="1" CornerRadius="4"
                                    ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="OnFocusBarClick" SizeChanged="OnFocusBarSized"
                                    ToolTip="Where focus is now, from close up to infinity. Click to jump there.">
                                <Canvas x:Name="FocusBarTicks" />
                            </Border>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Text="Focus magnifier" FontSize="12" Foreground="Gray" Margin="0,8,0,3" />
                    <StackPanel x:Name="MagnifierButtons" Orientation="Horizontal" />
                    <Button x:Name="StopTracking" Content="Stop tracking" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnStopTrackingClick" Visibility="Collapsed" />
                    <TextBlock x:Name="TouchHint" TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,6,0,0"
                               Text="" />

                    <TextBlock Text="AUDIO" Style="{StaticResource Section}" />
                    <Grid x:Name="Meters" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="14" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="L" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                        <TextBlock Text="R" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Grid.Row="2" />
                        <Grid x:Name="MeterLTrack" Grid.Column="1" Background="#2A2A2A">
                            <Rectangle x:Name="MeterL" HorizontalAlignment="Left" Width="0" />
                            <Rectangle x:Name="HoldL" HorizontalAlignment="Left" Width="2" Fill="White" Visibility="Collapsed" />
                        </Grid>
                        <Grid x:Name="MeterRTrack" Grid.Column="1" Grid.Row="2" Background="#2A2A2A">
                            <Rectangle x:Name="MeterR" HorizontalAlignment="Left" Width="0" />
                            <Rectangle x:Name="HoldR" HorizontalAlignment="Left" Width="2" Fill="White" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="MeterLText" Grid.Column="2" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock x:Name="MeterRText" Grid.Column="2" Grid.Row="2" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="MeterHint" TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,0,0,4" />
                    <StackPanel x:Name="AudioPanel" />

                    <Expander Header="More camera settings" Margin="0,18,0,0" IsExpanded="False">
                        <StackPanel x:Name="MorePanel" Margin="0,6,0,0" />
                    </Expander>

                    <TextBlock Text="PICTURE" Style="{StaticResource Section}" />
                    <DockPanel>
                        <Button Content="↻" DockPanel.Dock="Right" Width="34" Margin="6,0,0,0" Click="OnRefreshSourcesClick"
                                ToolTip="Look for capture cards again (after plugging one in)" />
                        <ComboBox x:Name="VideoDevices" SelectionChanged="OnVideoDeviceChanged"
                                  ToolTip="Camera over Wi-Fi needs no cable. Any HDMI capture card Windows sees is listed too." />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock x:Name="RotationText" Text="Rotation 0°" VerticalAlignment="Center" Width="90" DockPanel.Dock="Left" />
                        <UniformGrid Rows="1">
                            <Button Content="⟲ Left" Margin="0,0,3,0" Padding="4,5" Click="OnRotateClick" Tag="-90"
                                    ToolTip="Turn the picture 90° counter-clockwise (for a camera on its side)" />
                            <Button Content="⟳ Right" Margin="3,0,0,0" Padding="4,5" Click="OnRotateClick" Tag="90"
                                    ToolTip="Turn the picture 90° clockwise (for a camera on its side)" />
                        </UniformGrid>
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,6,0,0"
                               Text="Wi-Fi live view works with no cable. For the sharpest, smoothest picture, run HDMI into a capture card (camera HDMI Resolution: 1080p)." />

                    <TextBlock Text="PHONE" Style="{StaticResource Section}" />
                    <CheckBox x:Name="PhoneEnabled" Content="Allow phone control" Click="OnPhoneToggle"
                              ToolTip="Serves a control page to your home network and Tailscale. Keeps the PC awake while on." />
                    <TextBlock x:Name="PhoneInfo" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Popup x:Name="AssistDetail" PlacementTarget="{Binding ElementName=HistogramBox}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" Closed="OnAssistDetailClosed">
            <Border Width="340" Padding="14" Background="#1B1E22" BorderBrush="#444" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <Border Height="130" Background="#111">
                        <Image x:Name="HistogramLarge" Stretch="Fill" />
                    </Border>
                    <TextBlock x:Name="DetailText" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,6,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Zebra level" Style="{StaticResource Label}" />
                        <ComboBox x:Name="ZebraLevelBox" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="OnAssistSettingChanged" />
                        <TextBlock Text="Peaking sensitivity" Grid.Row="1" Style="{StaticResource Label}" />
                        <ComboBox x:Name="PeakSensitivityBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="OnAssistSettingChanged" />
                        <TextBlock Text="Peaking colour" Grid.Row="2" Style="{StaticResource Label}" />
                        <ComboBox x:Name="PeakColorBox" Grid.Row="2" Grid.Column="1" SelectionChanged="OnAssistSettingChanged" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,10,0,0"
                               Text="These read the picture you see here, not the recorded file. A Monitor LUT or Gamma Display Assist changes what they show." />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
