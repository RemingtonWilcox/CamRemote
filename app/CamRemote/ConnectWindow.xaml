<Window x:Class="CamRemote.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="CamRemote.ico"
        Title="Connect camera" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Loaded="OnLoaded">
    <StackPanel Margin="18">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Search again" Click="OnSearch" x:Name="SearchButton" />
            <TextBlock Text="Cameras found on Wi-Fi / USB" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox x:Name="Found" Height="110" Margin="0,8,0,0" SelectionChanged="OnFoundSelected" />
        <TextBlock x:Name="SearchStatus" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,4,0,0" />

        <TextBlock Text="Camera IP address (if it isn't found above)" Margin="0,14,0,4" />
        <TextBox x:Name="IpBox" />

        <TextBlock Text="Access Authen. user" Margin="0,12,0,4" />
        <TextBox x:Name="UserBox" />
        <TextBlock Text="Access Authen. password" Margin="0,12,0,4" />
        <PasswordBox x:Name="PasswordBox" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,6,0,0"
                   Text="On the camera: MENU › Network › Network Option › Access Authen. Settings. The password is saved in Windows Credential Manager." />

        <CheckBox x:Name="AutoBox" Content="Connect automatically when CamRemote starts" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
            <Button Content="Connect" IsDefault="True" Click="OnConnect" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
