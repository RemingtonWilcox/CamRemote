<Window x:Class="CamRemote.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="CamRemote.ico"
        Title="Connect camera" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Loaded="OnLoaded">
    <StackPanel Margin="18">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Search again" Click="OnSearch" x:Name="SearchButton" />
            <TextBlock Text="Cameras found on Wi-Fi / USB" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox x:Name="Found" Height="110" Margin="0,8,0,0" SelectionChanged="OnFoundSelected" />
        <TextBlock x:Name="SearchStatus" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,4,0,0" />

        <TextBlock Text="Camera IP address and model (if it isn't found above)" Margin="0,14,0,4" />
        <TextBox x:Name="IpBox" />
        <ComboBox x:Name="ModelBox" Margin="0,6,0,0" />

        <TextBlock Text="Access Authen. user" Margin="0,12,0,4" />
        <TextBox x:Name="UserBox" />
        <TextBlock Text="Access Authen. password" Margin="0,12,0,4" />
        <PasswordBox x:Name="PasswordBox" />
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,6,0,0"
                   Text="On the camera: MENU › Network › Network Option › Access Authen. Settings. The password is saved in Windows Credential Manager." />

        <CheckBox x:Name="AutoBox" Content="Connect automatically when RemoteCam starts" Margin="0,14,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
            <Button Content="Connect" IsDefault="True" Click="OnConnect" MinWidth="90" />
        </StackPanel>

        <!-- The camera takes one remote at a time, so another device that has it passes it on instead. -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Is your iPhone, iPad or another computer already using the camera?" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,4,0,0"
                           Text="Use it through that RemoteCam instead. Turn on Allow control from a computer there (on a PC or Mac: Allow phone control in Setup), then type the address and access code it shows." />
                <TextBlock Text="Its address" Margin="0,10,0,4" />
                <TextBox x:Name="JoinAddressBox" />
                <TextBlock Text="Access code (only the first time)" Margin="0,10,0,4" />
                <TextBox x:Name="JoinCodeBox" CharacterCasing="Upper" />
                <TextBlock x:Name="JoinStatus" TextWrapping="Wrap" Foreground="{StaticResource Warn}" FontSize="12" Margin="0,6,0,0" />
                <Button x:Name="JoinButton" Content="Use it through that RemoteCam" Click="OnJoin" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="12,3" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
