<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>CamRemote</AssemblyName>
    <RootNamespace>CamRemote</RootNamespace>
    <ApplicationIcon>CamRemote.ico</ApplicationIcon>
    <!-- WPF's Fluent dark theme (ThemeMode) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Native bridge (built by build.ps1) and Sony's runtime DLLs. The SDK looks for CrAdapter\ next to the exe. -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\</RepoRoot>
    <CrRuntime>$(RepoRoot)vendor\CrSDK\RemoteCli\external\crsdk\</CrRuntime>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(RepoRoot)build\bridge\Release\CamBridge.dll" Link="CamBridge.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(CrRuntime)*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(CrRuntime)CrAdapter\*.dll" Link="CrAdapter\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <Resource Include="CamRemote.ico" />
  </ItemGroup>

</Project>
